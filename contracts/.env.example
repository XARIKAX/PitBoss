# ============================================================
# PitBoss — Deploy .env  (Robinhood Chain, chainId 4663)
# Copy to .env, fill in the 🔲 blanks, then run the sequence
# below.  Never commit .env with a real private key.
# ============================================================

# ── Deployer ─────────────────────────────────────────────────
# Hot-wallet used for the initial deploy.  Transfer ownership
# to a multisig after deployment (call transferOwnership on each
# contract via Ownable).
PRIVATE_KEY=0x...        # 🔲 deployer private key (never commit this)

# ── RPC ──────────────────────────────────────────────────────
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# ── Fee / reward recipients ───────────────────────────────────
TREASURY=0x2fA1E9372c128e2A756f5BdD096d398eAEa0B659        # deployer EOA (can reassign later)
PROTOCOL_RESERVE=0x5Ce7FFce7c0cFb5210ADC4D23080f02B4379C61E
ROYALTY_RECEIVER=0x5Ce7FFce7c0cFb5210ADC4D23080f02B4379C61E

# ── Oracle + adapter owner ────────────────────────────────────
# The account that can call setTokenFeed / setRouteVia / setPoolFee
# on the deployed adapters.
OWNER=0x2fA1E9372c128e2A756f5BdD096d398eAEa0B659            # deployer EOA

# ── Chainlink oracle ──────────────────────────────────────────
ETH_USD_FEED=0x9F738359CF9A3630d08a79d80dE1aB803Cb2f7dD   # confirmed UnstaleWrapper
CHAINLINK_MAX_AGE=3600   # seconds — tighten to feed heartbeat once known

# ── Uniswap V3 (Robinhood Chain) ─────────────────────────────
# Find these at https://explorer.robinhood.com or the Uniswap
# deployment registry at https://docs.uniswap.org/contracts/v3/reference/deployments
UNIV3_ROUTER=0xcaf681a66d020601342297493863e78c959e5cb2      # SwapRouter02
V3_POSITION_MGR=0x73991a25c818bf1f1128deaab1492d45638de0d3  # NonfungiblePositionManager
V3_FACTORY=0x1f7d7550b1b028f7571e69a784071f0205fd2efa       # UniswapV3Factory
WETH=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73             # confirmed
POOL_FEE=3000            # 0.3% — matches the WETH→USDG→stock routes

# ── Randomness ────────────────────────────────────────────────
VRF_SERVICE=0x19856b7E4Ab191fC265525E400b9E686f75AE327       # BlockhashRandomnessServiceV3

# ── $PIT token ───────────────────────────────────────────────
# Leave blank (or omit) for the initial deploy — all three
# contracts (FlatAMMVault, ActivationManager, LoanVault) will
# deploy with pit = address(0) and expose a one-time setPIT()
# setter that you call after Pons graduation.
PIT_TOKEN=               # 🔲 fill AFTER launching $PITBOSS on Pons, then call setPIT()

# ── Mocks flag ────────────────────────────────────────────────
USE_MOCKS=false
