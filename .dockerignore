# Keeper image needs only apps/keeper source — keep the build context tiny.
.git
**/node_modules
**/.next
**/out
**/dist
art
# Keep the deployments artifact — the keeper resolves every contract address
# from it. Excluding all of contracts/ left the image with no addresses at all,
# so every bot started clean and then silently did nothing.
contracts/*
!contracts/deployments
docs
apps/web
*.log
.env
.env.*
