# Keeper image needs only apps/keeper source — keep the build context tiny.
.git
**/node_modules
**/.next
**/out
**/dist
art
# contracts/deployments must reach the image — the keeper resolves every address
# from it, and excluding all of contracts/ left the bots with no addresses at all.
# Exclude the heavy subdirectories by name rather than excluding contracts/ and
# re-including one child: a `!` exception under an excluded parent is the kind of
# pattern that behaves differently across builders, and this needs to be boring.
contracts/lib
contracts/out
contracts/cache
contracts/broadcast
contracts/src
contracts/test
contracts/script
contracts/scripts
docs
apps/web
*.log
.env
.env.*
