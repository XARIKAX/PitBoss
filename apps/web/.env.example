# --- RPC endpoints (single source of truth is config/chains.ts) ---
# Robinhood Chain (primary, chainId 4663)
NEXT_PUBLIC_RPC_ROBINHOOD=https://rpc.robinhood.example
# Base (fallback, chainId 8453)
NEXT_PUBLIC_RPC_BASE=https://mainnet.base.org

# --- WalletConnect ---
# https://cloud.walletconnect.com  (TODO: set a real project id)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Geo gate ---
# Optional IP-geolocation endpoint used by the /pit geo-gate placeholder.
# Leave blank to fall back to self-attestation only.
NEXT_PUBLIC_GEO_LOOKUP_URL=

# --- Local anvil fork (chainId 31337) ---
# Set to 1 to add the anvil chain to the app (dev only).
NEXT_PUBLIC_ENABLE_ANVIL=
NEXT_PUBLIC_RPC_ANVIL=http://127.0.0.1:8545
