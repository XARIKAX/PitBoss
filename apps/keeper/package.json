{
  "name": "@pitbosses/keeper",
  "version": "0.1.0",
  "private": true,
  "description": "PitBosses keeper bots — permissionless upkeep for the floor (fulfill, crank, restock, season leaderboard).",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "fulfill": "tsx src/fulfill.ts",
    "crank-watch": "tsx src/crank-watch.ts",
    "restock": "tsx src/restock.ts",
    "season-agg": "tsx src/season-agg.ts",
    "dev:fulfill": "tsx watch src/fulfill.ts",
    "dev:crank-watch": "tsx watch src/crank-watch.ts",
    "dev:restock": "tsx watch src/restock.ts",
    "dev:season-agg": "tsx watch src/season-agg.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "viem": "^2.17.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.3"
  },
  "packageManager": "pnpm@9.6.0"
}
